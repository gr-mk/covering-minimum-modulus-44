theorem walkUpTo_0 : ∀ i, i < 128 → walk6 boxInfo boxN i 54 0 = true := by
  intro i hi
  have hk := wBlock0 (i - 0) (by omega)
  rwa [show 0 + (i - 0) = i by omega] at hk

theorem walkUpTo_1 : ∀ i, i < 256 → walk6 boxInfo boxN i 54 0 = true := by
  intro i hi
  by_cases h : i < 128
  · exact walkUpTo_0 i h
  have hk := wBlock1 (i - 128) (by omega)
  rwa [show 128 + (i - 128) = i by omega] at hk

